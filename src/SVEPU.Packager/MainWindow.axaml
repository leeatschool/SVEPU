<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SVEPU.Core.Models"
        x:Class="SVEPU.Packager.MainWindow"
        Title="SVEPU - Stardew Valley Easy Port Utility"
        Width="980"
        Height="680"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">

    <!-- Header Banner -->
    <Border Grid.Row="0"
            Background="#FFF8DC"
            BorderBrush="#8B4513"
            BorderThickness="2"
            CornerRadius="8"
            Padding="16,12"
            Margin="0,0,0,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image x:Name="AppHeaderIcon"
               Grid.Column="0"
               Width="48"
               Height="48"
               Margin="0,0,14,0"
               VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="SVEPU - Stardew Valley Easy Port Utility"
                     FontSize="20"
                     FontWeight="Bold"
                     Foreground="#3E2723" />
          <TextBlock Text="Package and share your Stardew Valley mods across any device."
                     FontSize="13"
                     Foreground="#6D4C41" />
        </StackPanel>
        <Button Grid.Column="2"
                Content="Auto-Detect My Stardew Mods Folder"
                Classes="secondary"
                VerticalAlignment="Center"
                Click="OnAutoDetectModsClicked" />
      </Grid>
    </Border>

    <!-- Main Content: Left (Dropzone + Mod List) | Right (Package Metadata & Settings) -->
    <Grid Grid.Row="1" ColumnDefinitions="1.35*,14,1*">

      <!-- Left Column: Dropzone & Mod List -->
      <Border Grid.Column="0"
              Background="#FFF8DC"
              BorderBrush="#8B4513"
              BorderThickness="2"
              CornerRadius="8"
              Padding="14">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

          <!-- Drag & Drop Zone -->
          <Border x:Name="DropZoneBorder"
                  Grid.Row="0"
                  Background="#F5DEB3"
                  BorderBrush="#8B4513"
                  BorderThickness="2"
                  CornerRadius="8"
                  Padding="14,12"
                  Margin="0,0,0,10"
                  DragDrop.AllowDrop="True">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="Drag &amp; drop mod folders, a 'Mods' directory, or .zip archives here"
                         FontWeight="Bold"
                         FontSize="13"
                         HorizontalAlignment="Center"
                         TextAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Content="+ Add Mod Folder(s)..."
                        Classes="secondary"
                        FontSize="12"
                        Click="OnAddModFolderClicked" />
                <Button Content="+ Add Mod .zip..."
                        Classes="secondary"
                        FontSize="12"
                        Click="OnAddModZipClicked" />
                <Button Content="Clear All"
                        Classes="secondary"
                        FontSize="12"
                        Click="OnClearModsClicked" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Mod List Header & Toolbar -->
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
            <TextBlock x:Name="ModsCountHeaderText"
                       Grid.Column="0"
                       Text="Detected Mods (0 selected of 0)"
                       FontWeight="Bold"
                       FontSize="14"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Select All"
                    Classes="secondary"
                    Padding="8,3"
                    FontSize="11"
                    Margin="0,0,6,0"
                    Click="OnSelectAllClicked" />
            <Button Grid.Column="2"
                    Content="Deselect All"
                    Classes="secondary"
                    Padding="8,3"
                    FontSize="11"
                    Click="OnDeselectAllClicked" />
          </Grid>

          <!-- Scrollable Mod List -->
          <Border Grid.Row="2"
                  Background="#F5DEB3"
                  BorderBrush="#8B4513"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="8">
            <Grid>
              <TextBlock x:Name="EmptyModsPlaceholder"
                         Text="No mods added yet. Drag folders or .zip files above, or click 'Auto-Detect My Stardew Mods Folder'."
                         Foreground="#6D4C41"
                         FontSize="12"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         TextAlignment="Center"
                         Margin="24" />
              <ScrollViewer>
                <ItemsControl x:Name="ModsItemsControl">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ModEntry">
                      <Border Background="#FFF8DC"
                              BorderBrush="#8B4513"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="10,7"
                              Margin="0,0,0,6">
                        <Grid ColumnDefinitions="*,Auto">
                          <CheckBox Grid.Column="0"
                                    IsChecked="{Binding IsSelected}"
                                    VerticalAlignment="Center">
                            <StackPanel Spacing="2" Margin="4,0,0,0">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" />
                                <TextBlock Text="{Binding Version}" Foreground="#6D4C41" FontSize="12" />
                                <Border Background="#F5DEB3"
                                        BorderBrush="#8B4513"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="5,1"
                                        IsVisible="{Binding HasConfigJson}">
                                  <TextBlock Text="config.json" FontSize="10" Foreground="#3E2723" />
                                </Border>
                              </StackPanel>
                              <TextBlock FontSize="11" Foreground="#6D4C41">
                                <Run Text="By " />
                                <Run Text="{Binding Author}" />
                                <Run Text=" • ID: " />
                                <Run Text="{Binding UniqueID}" />
                                <Run Text=" • " />
                                <Run Text="{Binding SourceTypeDisplay}" />
                              </TextBlock>
                              <TextBlock Text="{Binding DependencyWarning}"
                                         IsVisible="{Binding HasWarning}"
                                         Foreground="#B71C1C"
                                         FontWeight="SemiBold"
                                         FontSize="11"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </CheckBox>

                          <Button Grid.Column="1"
                                  Content="✕"
                                  Classes="secondary"
                                  Padding="7,2"
                                  FontSize="11"
                                  VerticalAlignment="Center"
                                  Tag="{Binding}"
                                  Click="OnRemoveModItemClicked" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Config.json Inclusion Option -->
          <CheckBox x:Name="IncludeConfigJsonCheck"
                    Grid.Row="3"
                    IsChecked="True"
                    Margin="0,8,0,0"
                    Content="Include mod config.json files (uncheck to strip local settings for a fresh install)" />
        </Grid>
      </Border>

      <!-- Right Column: Package Metadata & Settings -->
      <Border Grid.Column="2"
              Background="#FFF8DC"
              BorderBrush="#8B4513"
              BorderThickness="2"
              CornerRadius="8"
              Padding="14">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Text="Package Metadata &amp; Icon"
                       FontSize="15"
                       FontWeight="Bold" />

            <StackPanel Spacing="4">
              <TextBlock Text="Pack Name:" FontWeight="SemiBold" FontSize="12" />
              <TextBox x:Name="PackNameTextBox"
                       Text="My Stardew Modpack"
                       Watermark="e.g. Stardew Valley Expanded Pack" />
            </StackPanel>

            <Grid ColumnDefinitions="*,10,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Author:" FontWeight="SemiBold" FontSize="12" />
                <TextBox x:Name="AuthorTextBox"
                         Text="Aaron"
                         Watermark="Author name" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Version:" FontWeight="SemiBold" FontSize="12" />
                <TextBox x:Name="VersionTextBox"
                         Text="1.0.0"
                         Watermark="1.0.0" />
              </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
              <TextBlock Text="Description / Release Notes:" FontWeight="SemiBold" FontSize="12" />
              <TextBox x:Name="DescriptionTextBox"
                       Height="76"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       Text="A custom Stardew Valley modpack packaged with SVEPU."
                       Watermark="Shown on the Installer Wizard welcome screen..." />
            </StackPanel>

            <!-- Custom Icon Picker -->
            <Border Background="#F5DEB3"
                    BorderBrush="#8B4513"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
              <Grid ColumnDefinitions="Auto,12,*">
                <Border Grid.Column="0"
                        Background="#FFF8DC"
                        BorderBrush="#8B4513"
                        BorderThickness="1"
                        CornerRadius="6"
                        Width="56"
                        Height="56"
                        Padding="4">
                  <Image x:Name="CustomIconPreviewImage" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center">
                  <TextBlock Text="Custom Package Icon:" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock x:Name="CustomIconNameText"
                             Text="Default (app-icon.png)"
                             FontSize="11"
                             Foreground="#6D4C41"
                             TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Choose Image..."
                            Classes="secondary"
                            Padding="8,4"
                            FontSize="11"
                            Click="OnChooseCustomIconClicked" />
                    <Button Content="Reset"
                            Classes="secondary"
                            Padding="8,4"
                            FontSize="11"
                            Click="OnResetCustomIconClicked" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Output Directory -->
            <StackPanel Spacing="4" Margin="0,4,0,0">
              <TextBlock Text="Output Folder:" FontWeight="SemiBold" FontSize="12" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="OutputFolderTextBox"
                         Grid.Column="0"
                         Watermark="Directory where the package will be saved..." />
                <Button Grid.Column="1"
                        Content="Browse..."
                        Classes="secondary"
                        Margin="6,0,0,0"
                        Click="OnBrowseOutputFolderClicked" />
              </Grid>
            </StackPanel>

            <CheckBox x:Name="KeepUnzippedFolderCheck"
                      IsChecked="True"
                      Content="Keep unzipped cross-platform folder alongside the .zip archive"
                      FontSize="12" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Bottom Action & Progress Bar -->
    <Border Grid.Row="2"
            Background="#FFF8DC"
            BorderBrush="#8B4513"
            BorderThickness="2"
            CornerRadius="8"
            Padding="14,10"
            Margin="0,14,0,0">
      <Grid ColumnDefinitions="*,12,Auto,12,Auto">
        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
          <ProgressBar x:Name="PackagingProgressBar" Minimum="0" Maximum="100" Value="0" />
          <TextBlock x:Name="PackagingStatusText"
                     Text="Ready. Add mods and click 'Package Mods' to create your cross-platform installer."
                     FontSize="12"
                     Foreground="#6D4C41"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Button x:Name="OpenOutputFolderBtn"
                Grid.Column="2"
                Content="Open Output Folder"
                Classes="secondary"
                VerticalAlignment="Center"
                Click="OnOpenOutputFolderClicked" />

        <Button x:Name="PackageModsBtn"
                Grid.Column="4"
                Content="Package Mods"
                Classes="primary"
                VerticalAlignment="Center"
                Click="OnPackageModsClicked" />
      </Grid>
    </Border>

  </Grid>
</Window>
